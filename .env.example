# .env.example
# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=replace-with-a-real-secret-key
DEBUG=True

DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/nexus_db

ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=nexus_db
DB_USER=postgres
DB_PASSWORD=yourpassword