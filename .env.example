# .env.example
# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=replace-with-a-real-secret-key
DEBUG=True

DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/nexus_db

ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=nexus_db
DB_USER=postgres
DB_PASSWORD=yourpassword

REDIS_URL=redis://redis:6379/0
REDIS_URL_CELERY=redis://redis:6379/1

EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_HOST_USER=your-mailtrap-user
EMAIL_HOST_PASSWORD=your-mailtrap-password
DEFAULT_FROM_EMAIL=noreply@nexus.app

SMS_BACKEND=console
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+15551234567

REDIS_URL_CHANNELS=redis://redis:6379/2

TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather