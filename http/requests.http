@baseUrl = http://127.0.0.1:8000/api/v1

@clientEmail = client1@example.com
@clientPassword = clientpass123

@freelancerEmail = freelancer1@example.com
@freelancerPassword = freelancerpass123

@otherClientEmail = client2@example.com
@otherClientPassword = clientpass456

@ticketId = 5
@staffToken ={{adminLogin.response.body.access}}

### =========================================
### Health Check
### =========================================
GET {{baseUrl}}/health/
Accept: application/json

### =========================================
### AUTHENTICATION
### =========================================

### Login ADMIN
# @name adminLogin
POST {{baseUrl}}/auth/login/
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "adminpass123"
}

###
@adminToken = {{adminLogin.response.body.access}}

### Login CLIENT
# @name clientLogin
POST {{baseUrl}}/auth/login/
Content-Type: application/json

{
  "email": "{{clientEmail}}",
  "password": "{{clientPassword}}"
}

###

@clientToken = {{clientLogin.response.body.access}}


### Login FREELANCER
# @name freelancerLogin
POST {{baseUrl}}/auth/login/
Content-Type: application/json

{
  "email": "{{freelancerEmail}}",
  "password": "{{freelancerPassword}}"
}

###

@freelancerToken = {{freelancerLogin.response.body.access}}


### Login OTHER CLIENT
# @name otherClientLogin
POST {{baseUrl}}/auth/login/
Content-Type: application/json

{
  "email": "{{otherClientEmail}}",
  "password": "{{otherClientPassword}}"
}

###

@otherClientToken = {{otherClientLogin.response.body.access}}

### =========================================
### HAPPY PATH
### =========================================

### 1. CLIENT creates a project (defaults to DRAFT)
# @name createProject
POST {{baseUrl}}/projects/
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "title": "Build a landing page",
  "description": "Simple one-page site with a contact form",
  "budget": "500.00",
  "deadline": "2026-09-01"
}

###

@projectId = {{createProject.response.body.id}}

### 2. CLIENT patches project status DRAFT -> OPEN
PATCH {{baseUrl}}/projects/{{projectId}}/
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "status": "OPEN"
}

### 3. CLIENT views their own projects (any status)
GET {{baseUrl}}/projects/mine/
Authorization: Bearer {{clientToken}}

### 4. FREELANCER lists OPEN projects
GET {{baseUrl}}/projects/
Authorization: Bearer {{freelancerToken}}

### 5. FREELANCER lists OPEN projects filtered by budget range
GET {{baseUrl}}/projects/?status=OPEN&budget_min=100&budget_max=1000
Authorization: Bearer {{freelancerToken}}

### 6. FREELANCER submits a proposal on the OPEN project
# @name createProposal
POST {{baseUrl}}/projects/{{projectId}}/proposals/
Authorization: Bearer {{freelancerToken}}
Content-Type: application/json

{
  "cover_letter": "I can build this in 3 days with a responsive layout.",
  "bid_amount": "450.00"
}

###

@proposalId = {{createProposal.response.body.id}}

### 7. CLIENT (owner) lists all proposals on their project
GET {{baseUrl}}/projects/{{projectId}}/proposals/
Authorization: Bearer {{clientToken}}

### 8. FREELANCER edits their own PENDING proposal
PATCH {{baseUrl}}/projects/{{projectId}}/proposals/{{proposalId}}/
Authorization: Bearer {{freelancerToken}}
Content-Type: application/json

{
  "bid_amount": "400.00",
  "cover_letter": "Updated: I can build this in 2 days."
}

### 9. CLIENT accepts the proposal
# @name acceptProposal
POST {{baseUrl}}/projects/{{projectId}}/proposals/{{proposalId}}/accept/
Authorization: Bearer {{clientToken}}

###
@contractId = {{acceptProposal.response.body.id}}

### =========================================
### FAILURE PATHS
### =========================================

### F1. FREELANCER tries to create a project -> expect 403
POST {{baseUrl}}/projects/
Authorization: Bearer {{freelancerToken}}
Content-Type: application/json

{
  "title": "Should not be allowed",
  "description": "Freelancers cannot create projects",
  "budget": "100.00",
  "deadline": "2026-09-01"
}

### F2. CLIENT tries to propose on their own OPEN project -> expect 403
POST {{baseUrl}}/projects/{{projectId}}/proposals/
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "cover_letter": "Trying to bid on my own project",
  "bid_amount": "300.00"
}

### F3. FREELANCER submits duplicate proposal on same project -> expect 400
POST {{baseUrl}}/projects/{{projectId}}/proposals/
Authorization: Bearer {{freelancerToken}}
Content-Type: application/json

{
  "cover_letter": "Second attempt, should fail",
  "bid_amount": "420.00"
}

### F4. Different CLIENT tries to update another client's project -> expect 403/404
PATCH {{baseUrl}}/projects/{{projectId}}/
Authorization: Bearer {{otherClientToken}}
Content-Type: application/json

{
  "title": "Trying to hijack this project"
}

### F5. FREELANCER tries to create a proposal on a DRAFT project -> expect 400
# @name createDraftProject
POST {{baseUrl}}/projects/
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "title": "Still in draft",
  "description": "Not published yet",
  "budget": "200.00",
  "deadline": "2026-09-15"
}

###

@draftProjectId = {{createDraftProject.response.body.id}}

###
POST {{baseUrl}}/projects/{{draftProjectId}}/proposals/
Authorization: Bearer {{freelancerToken}}
Content-Type: application/json

{
  "cover_letter": "Trying to bid on a draft project",
  "bid_amount": "150.00"
}

### F6. FREELANCER tries to edit a proposal that's not PENDING anymore -> expect 403
PATCH {{baseUrl}}/projects/{{projectId}}/proposals/{{proposalId}}/
Authorization: Bearer {{freelancerToken}}
Content-Type: application/json

{
  "bid_amount": "999.00"
}

### F7. Non-owner (other client) tries to list proposals on someone else's project -> expect 403/404
GET {{baseUrl}}/projects/{{projectId}}/proposals/
Authorization: Bearer {{otherClientToken}}

### =========================================
### ERROR SHAPE CONSISTENCY CHECKS
### =========================================

### Check consistent error shape: validation error6. FREELANCER submits a proposal on the OPEN project
POST {{baseUrl}}/projects/
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "title": "",
  "description": "test",
  "budget": "-10.00",
  "deadline": "2020-01-01"
}

### Check consistent error shape: not found
GET {{baseUrl}}/projects/99999/
Authorization: Bearer {{clientToken}}

### Check consistent error shape: no auth
GET {{baseUrl}}/projects/mine/
### Admin top-up client's wallet
POST {{baseUrl}}/wallet/admin-topup/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "user_id": 3,
  "amount": 50000,
  "idempotency_key": "test-topup-001"
}

### Check client balance
GET {{baseUrl}}/wallet/
Authorization: Bearer {{clientToken}}

### ... (accept proposal, deliver, complete از فاز ۸) ...

### Check freelancer balance after contract completion
GET {{baseUrl}}/wallet/
Authorization: Bearer {{freelancerToken}}

### Check transaction history
GET {{baseUrl}}/wallet/transactions/
Authorization: Bearer {{clientToken}}

### Create a proposal (should trigger email + notification)
POST {{baseUrl}}/projects/{{projectId}}/proposals/
Authorization: Bearer {{freelancerToken}}
Content-Type: application/json

{
  "cover_letter": "Testing Celery notifications",
  "bid_amount": "300.00"
}

### Check in-app notifications for the client
GET {{baseUrl}}/notifications/
Authorization: Bearer {{clientToken}}


### Request OTP
POST {{baseUrl}}/auth/otp/request/
Content-Type: application/json

{
  "phone_number": "+989123456789"
}

### Check console/logs for the OTP code, then verify
POST {{baseUrl}}/auth/otp/verify/
Content-Type: application/json

{
  "phone_number": "+989123456789",
  "code": "PASTE_CODE_FROM_CONSOLE_HERE"
}

### Test rate limit: repeat request 4+ times quickly -> expect 429
POST {{baseUrl}}/auth/otp/request/
Content-Type: application/json

{
  "phone_number": "+989123456789"
}

### Freelancer delivers the contract
POST {{baseUrl}}/contracts/{{contractId}}/deliver/
Authorization: Bearer {{freelancerToken}}

### Raise a dispute on a contract → should auto-create a ticket
POST {{baseUrl}}/contracts/{{contractId}}/dispute/
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "note": "Freelancer did not deliver as agreed."
}

### Check that a ticket was created linked to this contract
GET {{baseUrl}}/tickets/mine/
Authorization: Bearer {{clientToken}}

### User opens a ticket
POST {{baseUrl}}/tickets/
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "subject": "Question about my payment",
  "category": "PAYMENT"
}

### Other client tries to see it -> expect empty list or 403/404
GET {{baseUrl}}/tickets/
Authorization: Bearer {{otherClientToken}}

### Staff replies
POST {{baseUrl}}/tickets/{{ticketId}}/messages/
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "body": "We're looking into this, thanks for your patience."
}

### Staff closes with resolution
PATCH {{baseUrl}}/tickets/{{ticketId}}/
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "status": "RESOLVED",
  "resolution": "Payment was confirmed and applied correctly."
}